{
  "name": "amigolint",
  "version": "0.0.0",
  "description": "Lint your CLAUDE.md, AGENTS.md, Cursor rules and Copilot instructions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Amerigo2020/amigolint.git"
  },
  "type": "module",
  "bin": {
    "amigolint": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "tsc --noEmit && tsdown",
    "dev": "tsx src/cli.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "14.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@types/node": "20.11.0",
    "tsdown": "0.20.3",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "tsdown": {
    "entry": "src/cli.ts",
    "clean": true,
    "dts": false,
    "fixedExtension": true,
    "format": "esm",
    "outDir": "dist",
    "platform": "node",
    "sourcemap": false,
    "target": "node20"
  }
}
